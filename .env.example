# Server
PORT=3000
NODE_ENV=production
SITE_URL=https://your-domain.vercel.app
SESSION_SECRET=change-me-to-a-long-random-string

# --- Required on Vercel (Project → Settings → Environment Variables) ---

# Supabase (prefer new key format)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy aliases (optional — still supported)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Printify
PRINTIFY_API_KEY=your-printify-api-key
PRINTIFY_SHOP_ID=your-shop-id

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Admin (comma-separated emails)
ADMIN_EMAILS=admin@memonuvia.com

# Notes for Vercel:
# 1. Set SITE_URL to your production URL (e.g. https://memonuvia.com)
# 2. Add Stripe webhook endpoint: https://YOUR_DOMAIN/api/webhooks/stripe
# 3. Supabase Auth redirect URLs must include https://YOUR_DOMAIN/auth/callback
# 4. Never commit real .env values — only configure them in the Vercel dashboard
