# =============================================================================
# Multi-tenant MemoNuvia storefront
# Shared Auth/Supabase project across sibling brands — isolate STORE_ID + payment/POD keys
# =============================================================================

# REQUIRED unique per brand (app refuses to start if empty)
NEXT_PUBLIC_STORE_ID=memonuvia
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MemoNuvia
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# SHARED across sibling storefronts (same Supabase project + Google OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# UNIQUE per storefront — never reuse between brands
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional comma-separated bootstrap admins (also use store_admins + profiles.role)
ADMIN_EMAILS=admin@memonuvia.com
# Default local admin (created via scripts/ensure-admin.mjs):
#   email: admin@memonuvia.com
#   password: MemoNuviaAdmin2026!

# Supabase Auth → URL Configuration → Redirect URLs:
#   https://this-brand.domain/auth/callback
#   https://sibling-brand.domain/auth/callback
#   http://localhost:3000/auth/callback
