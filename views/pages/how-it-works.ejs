<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page-shell">
  <div class="container section-center">
    <h1 class="section-title">Your memories, made personal.</h1>
    <p class="section-sub">Four simple steps from photo to natural slate.</p>
    <div class="how-grid" style="margin-top:2rem;text-align:left">
      <article class="how-card">
        <div class="how-visual how-visual--design">
          <%- include('../partials/slate', { theme: 'family', label: 'The Anderson Family', size: 'square', compact: true }) %>
        </div>
        <h3>Choose your design</h3>
        <p>Browse crystal illusion frames across Family, Couples, Kids, and Pets.</p>
      </article>
      <article class="how-card">
        <div class="how-visual how-visual--upload">Upload photo ↑</div>
        <h3>Upload your photo</h3>
        <p>Use a clear, well-lit photo. Phone photos work beautifully.</p>
      </article>
      <article class="how-card">
        <div class="how-visual how-visual--names">Emily &amp; James</div>
        <h3>Add your names</h3>
        <p>Preview text live on the slate before you checkout.</p>
      </article>
      <article class="how-card">
        <div class="how-visual how-visual--order" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 7h15l-1.5 9h-12z"/><path d="M6 7 5 3H2"/><circle cx="9" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>
        </div>
        <h3>Place your order</h3>
        <p>Pay with Stripe. We sync to Printify for production instantly.</p>
      </article>
    </div>
    <div style="margin-top:2rem">
      <a class="btn btn-primary" href="/shop">Start Personalizing →</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
