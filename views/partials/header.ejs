<div class="announcement" role="region" aria-label="Site announcement">
  <span class="announcement__spark" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M12 3v5M12 16v5M3 12h5M16 12h5M5.6 5.6l3.2 3.2M15.2 15.2l3.2 3.2M18.4 5.6l-3.2 3.2M8.8 15.2l-3.2 3.2" stroke="#F5D76E" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </span>
  <p class="announcement__text">Your photo. Your names. Your keepsake.</p>
  <span class="announcement__spark" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M12 3v5M12 16v5M3 12h5M16 12h5M5.6 5.6l3.2 3.2M15.2 15.2l3.2 3.2M18.4 5.6l-3.2 3.2M8.8 15.2l-3.2 3.2" stroke="#F5D76E" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </span>
</div>

<header class="site-header">
  <div class="container header-shell">
    <a class="logo" href="/" aria-label="MemoNuvia home">
      <span class="logo-mark" aria-hidden="true">
        <svg class="logo-mark__stone" viewBox="0 0 40 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.2 6.5C12.5 2.8 19.2 1.8 24.8 3.4c4.1 1.2 8.6 4.1 10.2 8.6 1.5 4.2.6 9.2-1.4 13.1-2.5 4.8-6.8 9.2-11.9 11.4-4.1 1.8-9 .9-12.6-1.8C5.4 31.8 2.6 26.7 2.2 21.2 1.7 15.2 3.8 10.2 8.2 6.5Z" stroke="#1D4D4F" stroke-width="2" stroke-linejoin="round"/>
          <path d="M20.2 15.2c1.4-1.5 3.7-1.5 5.1 0 1.5 1.6 1.4 4.1-.2 5.6l-4.7 4.5-4.7-4.5c-1.6-1.5-1.7-4-.2-5.6 1.4-1.5 3.6-1.5 5 0l.2.2.2-.2Z" fill="#E85A4F"/>
        </svg>
      </span>
      <span class="logo-word">
        Memo<span class="logo-word__accent">Nuvia</span>
      </span>
    </a>

    <div class="header-bar">
      <button class="icon-btn menu-toggle" id="menuToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mainNav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <nav class="nav" id="mainNav" aria-label="Primary">
        <a href="/shop" class="<%= typeof activeNav !== 'undefined' && activeNav === 'shop' ? 'active' : '' %>">Shop</a>
        <a href="/collections/family">Family</a>
        <a href="/collections/couples">Couples</a>
        <a href="/collections/pets">Pets</a>
        <a href="/collections/kids">Kids</a>
        <a href="/how-it-works">How It Works</a>
        <a href="/track">Track Order</a>
      </nav>

      <div class="header-tools">
        <span class="header-divider" aria-hidden="true"></span>
        <label class="locale-wrap">
          <select class="locale-select" id="localeSelect" aria-label="Country and currency">
            <option value="US-USD">US / USD</option>
            <option value="GB-GBP">UK / GBP</option>
            <option value="EU-EUR">EU / EUR</option>
          </select>
          <svg class="locale-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </label>
        <button class="icon-btn icon-btn--ghost" id="searchToggle" type="button" title="Search" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"/><path d="M16.5 16.5 21 21"/></svg>
        </button>
        <% if (typeof user !== 'undefined' && user) { %>
          <a class="icon-btn icon-btn--ghost" href="/account" title="My account" aria-label="My account">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.8-3.2 4.2-4.5 7-4.5s5.2 1.3 7 4.5"/></svg>
          </a>
        <% } else { %>
          <a class="icon-btn icon-btn--ghost" href="/auth?next=/account" title="Sign in" aria-label="Sign in">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.8-3.2 4.2-4.5 7-4.5s5.2 1.3 7 4.5"/></svg>
          </a>
        <% } %>
        <a class="icon-btn icon-btn--ghost" href="/cart" title="Cart" aria-label="Cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8h12l-1 11H7L6 8Z"/><path d="M9 8V7a3 3 0 0 1 6 0v1"/></svg>
          <span class="cart-count" id="cartCount">0</span>
        </a>
      </div>
    </div>
  </div>
</header>
