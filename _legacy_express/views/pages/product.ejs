<%- include('../partials/head') %>
<%- include('../partials/header', { activeNav: 'shop' }) %>

<main class="page-shell">
  <div class="container split">
    <div class="slate-stage" style="min-height:420px">
      <%- include('../partials/slate', { theme: product.theme, label: product.sample_text, size: 'square' }) %>
    </div>
    <div>
      <p class="eyebrow"><%= product.collection %></p>
      <h1 class="section-title" style="font-size:clamp(2rem,4vw,2.8rem)"><%= product.name %></h1>
      <p class="section-sub"><%= product.description %></p>
      <p class="price" style="font-size:1.4rem;margin:1rem 0">$<%= Number(product.price).toFixed(2) %></p>
      <div class="product-meta" style="margin-bottom:1.25rem">
        <% (product.shapes || []).forEach(function(s) { %>
          <span class="pill"><%= s %></span>
        <% }) %>
      </div>
      <a class="btn btn-primary" href="/personalize/<%= product.slug %>">Personalize →</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
