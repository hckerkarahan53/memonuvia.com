<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-side">
      <a href="/admin">← Orders</a>
      <a href="/admin/products">Products</a>
    </aside>
    <main class="admin-main">
      <div class="admin-header-row">
        <h1 class="admin-page-title"><%= order.order_number %></h1>
        <span class="status-pill <%= order.payment_status === 'paid' ? 'paid' : 'unpaid' %>"><%= order.payment_status %></span>
      </div>

      <div class="admin-detail-grid">
        <section class="panel ui-lift">
          <h2 class="admin-section-title">Customer &amp; shipping</h2>
          <p><strong>Name:</strong> <%= order.customer_name || '—' %></p>
          <p><strong>Email:</strong> <%= order.customer_email || '—' %></p>
          <p><strong>Status:</strong> <%= order.status %></p>
          <p><strong>Fulfillment:</strong> <%= order.fulfillment_status || 'pending' %></p>
          <p><strong>Total:</strong> $<%= Number(order.total).toFixed(2) %> <%= order.currency %></p>
          <p><strong>Stripe:</strong> <%= order.stripe_session_id || '—' %></p>
          <p><strong>Printify ID:</strong> <%= order.printify_order_id || 'Not sent yet' %></p>
          <% if (order.printify_last_error) { %>
            <p class="admin-error"><strong>Printify error:</strong> <%= order.printify_last_error %></p>
          <% } %>
          <h3 class="admin-section-title" style="margin-top:1.25rem">Shipping address</h3>
          <pre class="admin-pre"><%= JSON.stringify(order.shipping_address || {}, null, 2) %></pre>

          <div class="admin-toolbar" style="margin-top:1rem">
            <label>
              Update fulfillment
              <select id="fulfillmentSelect">
                <% ['pending','processing','shipped','delivered','cancelled'].forEach(function(s) { %>
                  <option value="<%= s %>" <%= (order.fulfillment_status || 'pending') === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </label>
            <button class="btn btn-ghost btn-sm ui-press" type="button" id="saveStatus">Save status</button>
            <button class="btn btn-primary btn-sm ui-press" type="button" id="pushPrintify">Push / retry Printify</button>
          </div>
          <p id="pushMsg" class="admin-msg"></p>
        </section>

        <section class="panel ui-lift">
          <h2 class="admin-section-title">Personalizations</h2>
          <% (order.items || []).forEach(function(item) { %>
            <article class="admin-pers-card">
              <div class="admin-pers-media">
                <% if (item.photo_url) { %>
                  <img src="<%= item.photo_url %>" alt="Customer upload" />
                  <a class="btn btn-ghost btn-sm ui-press" href="/api/admin/orders/<%= order.id %>/items/<%= item.id %>/photo">
                    Download original photo
                  </a>
                <% } else { %>
                  <div class="admin-pers-empty">No photo</div>
                <% } %>
              </div>
              <div>
                <strong><%= item.product_name %></strong>
                <p><strong>Text:</strong> <%= item.personalization_text || '—' %></p>
                <p><strong>Font:</strong> <%= item.font_family || 'script' %></p>
                <p><strong>Size / shape:</strong> <%= item.size || '—' %> / <%= item.shape || '—' %></p>
                <p><strong>Qty:</strong> <%= item.quantity %> · $<%= Number(item.unit_price).toFixed(2) %></p>
                <p><strong>Printify product:</strong> <%= item.printify_product_id || '—' %></p>
                <p><strong>Variant:</strong> <%= item.printify_variant_id || '—' %></p>
              </div>
            </article>
          <% }) %>
          <% if (order.notes) { %>
            <h3 class="admin-section-title">Notes</h3>
            <pre class="admin-pre"><%= order.notes %></pre>
          <% } %>
        </section>
      </div>
    </main>
  </div>
  <script>
    const orderId = <%- JSON.stringify(order.id) %>;
    const msg = document.getElementById('pushMsg');

    document.getElementById('pushPrintify')?.addEventListener('click', async () => {
      msg.textContent = 'Sending to Printify…';
      const res = await fetch(`/api/admin/orders/${orderId}/push-printify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin'
      });
      const data = await res.json().catch(() => ({}));
      msg.textContent = res.ok ? 'Printify sync updated.' : (data.error || 'Failed');
      if (res.ok) location.reload();
    });

    document.getElementById('saveStatus')?.addEventListener('click', async () => {
      const fulfillment_status = document.getElementById('fulfillmentSelect').value;
      msg.textContent = 'Saving…';
      const res = await fetch(`/api/admin/orders/${orderId}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ fulfillment_status })
      });
      const data = await res.json().catch(() => ({}));
      msg.textContent = res.ok ? 'Status saved.' : (data.error || 'Failed');
      if (res.ok) location.reload();
    });
  </script>
</body>
</html>
